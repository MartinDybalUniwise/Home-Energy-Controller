{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-energy-controller.local/sdd/step.schema.json",
  "title": "HEC SDD step manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["step", "classification", "status", "gate_a", "gate_b", "gate_c", "readiness", "requested_by", "source", "branch", "pr", "notes", "requirements", "acceptance", "evidence"],
  "properties": {
    "step": { "type": "integer", "minimum": 1 },
    "classification": { "type": "string", "enum": ["SMALL", "LARGE"] },
    "status": { "type": "string", "enum": ["PLANNED", "IN_PROGRESS", "DONE", "BLOCKED"] },
    "gate_a": { "$ref": "#/$defs/gate" },
    "gate_b": { "$ref": "#/$defs/gate" },
    "gate_c": { "$ref": "#/$defs/gate" },
    "readiness": { "type": "string", "enum": ["YES", "NO"] },
    "requested_by": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "branch": { "type": ["string", "null"] },
    "pr": { "type": ["integer", "string", "null"] },
    "notes": { "type": "string" },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at"],
      "properties": {
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "NOT_REQUESTED"] },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"] }
      }
    }
  }
}