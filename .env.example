# Home Energy Controller – tajemství.
# Zkopírovat na .env a vyplnit. Soubor .env NIKDY nepatří do gitu.
# Hodnoty se do konfigurace dosazují zápisem ${NAZEV} (viz connect.example.json).

# --- TNG (tngsmart.cz) ---
HEC_TNG_USERNAME=
HEC_TNG_PASSWORD=
HEC_TNG_THERMOSTAT_ID=
HEC_TNG_THERMOSTAT_KEY=
HEC_TNG_BASIC_KEY=
HEC_TNG_HEATPUMP_HASH=
HEC_TNG_TIMEZONE_COOKIE_NAME=

# --- GoodWe ---
HEC_GOODWE_HOST=192.168.2.116

# --- Shelly (volitelné heslo pro digest auth) ---
HEC_SHELLY_PASSWORD=

# --- Webové rozhraní ---
# Prázdné heslo = rozhraní bez přihlášení (jen pro důvěryhodnou síť).
HEC_WEB_PASSWORD=
